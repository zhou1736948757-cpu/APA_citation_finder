# APA_citation_finder — 可选环境变量（全部非必需；核心流无需任何 key）
# 复制为 .env 后按需填写。缺失时对应功能自动降级，管线照常运行。

# --- 支撑评分 LLM 引擎（Stage 6）---
# 不配置时：语义判定模式（主对话模型直接判定）或启发式兜底
USE_LLM_SUPPORT=false
LLM_API_KEY=
LLM_API_ENDPOINT=
LLM_MODEL=

# --- 可选检索源 ---
# Exa 语义检索（search_exa.py）
EXA_API_KEY=

# Semantic Scholar 限速缓解（verify_papers.py 第二来源）
S2_API_KEY=

# --- 审计（Gate 8B 独立评审）---
# 不配置时用确定性启发式
USE_LLM_AUDIT=false
